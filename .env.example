# Copy to .env for local runs. No secrets: every value here is public or local.
COLLECTIONS=spherex_dr1,spherex_qr3
PIXEL_SOURCE=s3            # s3 | cutout
S3_PREFETCH=true           # false = astropy reads on demand (slow; for comparison)
PIPELINE_VERSION=2
CACHE_DIR=./data
CACHE_MAX_GB=4
MAX_CONCURRENT_FETCH=24
MAX_EXPOSURES_PER_JOB=120
ALLOWED_ORIGINS=http://localhost:5173
# Frontend (public by definition: never put a secret behind VITE_)
VITE_API_BASE=http://localhost:8000/api
VITE_UMAMI_WEBSITE_ID=
