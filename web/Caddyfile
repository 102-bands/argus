# Static site for Railway (PRD §11.3). /api is proxied to the api service over Railway's private
# network (API_UPSTREAM, e.g. api.railway.internal:8000), so the site has one origin and no CORS.
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	@embed path /embed /embed/*
	header @embed Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is 'wasm-unsafe-eval'; connect-src 'self' {$API_ORIGIN} https://gateway.umami.is https://irsa.ipac.caltech.edu https://alasky.cds.unistra.fr; img-src 'self' data: blob: https://irsa.ipac.caltech.edu https://alasky.cds.unistra.fr; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors *"
	@notembed not path /embed /embed/*
	header @notembed Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is 'wasm-unsafe-eval'; connect-src 'self' {$API_ORIGIN} https://gateway.umami.is https://irsa.ipac.caltech.edu https://alasky.cds.unistra.fr; img-src 'self' data: blob: https://irsa.ipac.caltech.edu https://alasky.cds.unistra.fr; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

	handle /api/* {
		# flush_interval -1: stream job events (SSE) as they happen.
		reverse_proxy {$API_UPSTREAM:api.railway.internal:8000} {
			flush_interval -1
		}
	}

	@immutable path /assets/* /presets/*/frames/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Static files and the SPA fallback. Inside handle so try_files never rewrites /api/*.
	handle {
		try_files {path} /index.html
		file_server
	}
}
